# Persist the settings in state/environment (loaded by cs2.service) and write
# the container env files:
#   state/cs2.env        generated from the settings (joedwards32/cs2 variables)
#   state/cs2-extra.env  the "additional variables" verbatim, applied last

import json
import os
import sys

import agent

data = json.load(sys.stdin)

def flag(v):
    return "true" if v else "false"

# game_type/game_mode pairs of the CS2 dedicated server
GAME_MODES = {
    "casual": (0, 0), "competitive": (0, 1), "wingman": (0, 2),
    "armsrace": (1, 0), "demolition": (1, 1), "deathmatch": (1, 2),
    "custom": (3, 0),
}

def sed_safe(s):
    # The image substitutes these values into cfg files with sed: escape the
    # characters that would break the expression ("/" is documented as "\/").
    return (s or "").replace("\\", "\\\\").replace("/", "\\/").replace("&", "\\&")

name = (data.get("server_name") or "").strip() or "CS2 server"
password = (data.get("server_password") or "").strip()
game_port = int(data.get("game_port") or 27015)
lan = bool(data.get("lan_mode", False))
mode = data.get("game_mode") or "competitive"
map_group = (data.get("map_group") or "").strip() or "mg_active"
start_map = (data.get("start_map") or "").strip() or "de_inferno"
ws_coll = (data.get("workshop_collection") or "").strip()
ws_map = (data.get("workshop_map") or "").strip()
tv = bool(data.get("tv_enabled", False))
tv_port = int(data.get("tv_port") or 27020)
tv_pw = (data.get("tv_password") or "").strip()

token = os.environ.get("GSLT_TOKEN", "")
if data.get("gslt_clear"):
    token = ""
elif (data.get("gslt_token") or "").strip():
    token = data["gslt_token"].strip()

publish = [f"--publish {game_port}:27015/tcp", f"--publish {game_port}:27015/udp"]
if tv:
    publish.append(f"--publish {tv_port}:27020/udp")

agent.mset_env({
    "SERVER_NAME": name,
    "SERVER_PASSWORD": password,
    "GSLT_TOKEN": token,
    "MAX_PLAYERS": str(int(data.get("max_players") or 10)),
    "GAME_PORT": str(game_port),
    "LAN_MODE": flag(lan),
    "GAME_MODE": mode,
    "MAP_GROUP": map_group,
    "START_MAP": start_map,
    "WORKSHOP_COLLECTION": ws_coll,
    "WORKSHOP_MAP": ws_map,
    "BOT_DIFFICULTY": str(int(data.get("bot_difficulty", 1))),
    "BOT_QUOTA": str(int(data.get("bot_quota") or 0)),
    "BOT_QUOTA_MODE": data.get("bot_quota_mode") or "fill",
    "TV_ENABLED": flag(tv),
    "TV_PORT": str(tv_port),
    "TV_PASSWORD": tv_pw,
    "TV_DELAY": str(int(data.get("tv_delay") or 0)),
    "TV_AUTORECORD": flag(data.get("tv_autorecord", False)),
    "VALIDATE_FILES": flag(data.get("validate_files", False)),
    "ADDITIONAL_ARGS": (data.get("additional_args") or "").strip(),
    "CS2_PUBLISH_ARGS": " ".join(publish),
})

game_type, game_mode = GAME_MODES.get(mode, (0, 1))
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    f"SRCDS_TOKEN={token}",
    f"CS2_SERVERNAME={sed_safe(name)}",
    f"CS2_PW={sed_safe(password)}",
    f"CS2_RCONPW={os.environ['RCON_PASSWORD']}",
    f"CS2_MAXPLAYERS={int(data.get('max_players') or 10)}",
    # Fixed container-side ports; the node ports are the published ones.
    "CS2_PORT=27015",
    "CS2_IP=0.0.0.0",
    f"CS2_LAN={1 if lan else 0}",
    "CS2_GAMEALIAS=",
    f"CS2_GAMETYPE={game_type}",
    f"CS2_GAMEMODE={game_mode}",
    f"CS2_MAPGROUP={map_group}",
    f"CS2_STARTMAP={start_map}",
    f"CS2_HOST_WORKSHOP_COLLECTION={ws_coll}",
    f"CS2_HOST_WORKSHOP_MAP={ws_map}",
    f"CS2_BOT_DIFFICULTY={int(data.get('bot_difficulty', 1))}",
    f"CS2_BOT_QUOTA={int(data.get('bot_quota') or 0)}",
    f"CS2_BOT_QUOTA_MODE={data.get('bot_quota_mode') or 'fill'}",
    f"TV_ENABLE={1 if tv else 0}",
    "TV_PORT=27020",
    f"TV_PW={sed_safe(tv_pw)}",
    f"TV_RELAY_PW={sed_safe(tv_pw)}",
    f"TV_DELAY={int(data.get('tv_delay') or 0)}",
    f"TV_AUTORECORD={1 if data.get('tv_autorecord') else 0}",
    f"STEAMAPPVALIDATE={1 if data.get('validate_files') else 0}",
    f"CS2_ADDITIONAL_ARGS={(data.get('additional_args') or '').strip()}",
]
with open("cs2.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.chmod("cs2.env.tmp", 0o600)
os.replace("cs2.env.tmp", "cs2.env")

extra = [e.strip() for e in (data.get("extra_env") or []) if e.strip()]
with open("cs2-extra.env.tmp", "w") as fp:
    fp.write("# Additional variables from the settings page (applied last).\n")
    fp.write("".join(e + "\n" for e in extra))
os.replace("cs2-extra.env.tmp", "cs2-extra.env")
