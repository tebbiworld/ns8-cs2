{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure cs2",
    "$id": "http://nethserver.org/json-schema/task/input/cs2/configure-module",
    "description": "Configure the Counter-Strike 2 server module",
    "examples": [
        {
            "server_name": "Family CS2",
            "server_password": "",
            "gslt_token": "",
            "gslt_clear": false,
            "max_players": 10,
            "game_port": 27015,
            "lan_mode": false,
            "game_mode": "competitive",
            "map_group": "mg_active",
            "start_map": "de_inferno",
            "workshop_collection": "",
            "workshop_map": "",
            "bot_difficulty": 1,
            "bot_quota": 0,
            "bot_quota_mode": "fill",
            "tv_enabled": false,
            "tv_port": 27020,
            "tv_password": "",
            "tv_delay": 0,
            "tv_autorecord": false,
            "validate_files": false,
            "additional_args": "",
            "extra_env": []
        }
    ],
    "type": "object",
    "required": ["server_name", "max_players", "game_port", "game_mode"],
    "properties": {
        "server_name": { "type": "string", "title": "Server name", "minLength": 1, "maxLength": 100 },
        "server_password": { "type": "string", "title": "Server password", "description": "Players must enter it to join. Empty: open server.", "maxLength": 100 },
        "gslt_token": { "type": "string", "title": "Game Server Login Token", "description": "GSLT for app 730 from https://steamcommunity.com/dev/managegameservers. Required for players outside the LAN. Empty: keep the stored token.", "format": "password", "maxLength": 64 },
        "gslt_clear": { "type": "boolean", "title": "Remove the stored token" },
        "max_players": { "type": "integer", "minimum": 1, "maximum": 64 },
        "game_port": { "type": "integer", "title": "Game port (TCP+UDP)", "minimum": 1024, "maximum": 65535 },
        "lan_mode": { "type": "boolean", "title": "LAN mode", "description": "sv_lan 1: no Steam authentication, LAN clients only." },
        "game_mode": { "type": "string", "enum": ["casual", "competitive", "wingman", "armsrace", "demolition", "deathmatch", "custom"] },
        "map_group": { "type": "string", "pattern": "^[A-Za-z0-9_]*$", "maxLength": 64 },
        "start_map": { "type": "string", "pattern": "^[A-Za-z0-9_]*$", "maxLength": 64 },
        "workshop_collection": { "type": "string", "pattern": "^[0-9]*$", "maxLength": 20 },
        "workshop_map": { "type": "string", "pattern": "^[0-9]*$", "maxLength": 20 },
        "bot_difficulty": { "type": "integer", "minimum": 0, "maximum": 3 },
        "bot_quota": { "type": "integer", "minimum": 0, "maximum": 64 },
        "bot_quota_mode": { "type": "string", "enum": ["fill", "competitive", "normal"] },
        "tv_enabled": { "type": "boolean" },
        "tv_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "tv_password": { "type": "string", "maxLength": 100 },
        "tv_delay": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "tv_autorecord": { "type": "boolean" },
        "validate_files": { "type": "boolean", "title": "Validate game files at every start" },
        "additional_args": { "type": "string", "title": "Additional cs2 command line arguments", "maxLength": 1000 },
        "extra_env": {
            "type": "array",
            "title": "Additional container variables",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*=" }
        }
    }
}
