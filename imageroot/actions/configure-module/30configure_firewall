# Open the game port (tcp+udp) and the CSTV port on the node firewall as a
# public service named after the instance (replace_ports: a port change
# closes the old one).

import json
import os
import sys

import agent

data = json.load(sys.stdin)
module_id = os.environ["MODULE_ID"]
game_port = int(data["game_port"])
ports = [f"{game_port}/tcp", f"{game_port}/udp"]
if data.get("tv_enabled"):
    ports.append(f"{int(data.get('tv_port') or 27020)}/udp")
agent.assert_exp(agent.add_public_service(module_id, ports, replace_ports=True))
open(".public-service", "w").close()  # remembered for destroy-module
