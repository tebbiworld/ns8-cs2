# Run a server console command through RCON on the local game port and
# return its output (e.g. "status", "changelevel de_dust2", "bot_add").

import json
import os
import subprocess
import sys

import agent
import modsecrets

data = json.load(sys.stdin)
command = data["command"].strip()
try:
    proc = subprocess.run([os.path.expanduser("~/.config/bin/cs2-rcon"), os.environ.get("GAME_PORT", "27015"),
                           "-", command], capture_output=True, text=True, timeout=30,
                          # the password travels in the process environment, not on the command line
                          env=dict(os.environ, RCON_PASSWORD=modsecrets.get("RCON_PASSWORD")))
except subprocess.TimeoutExpired:
    print(agent.SD_ERR + "RCON timed out (server not running or still starting?)", file=sys.stderr)
    sys.exit(1)
if proc.returncode != 0:
    print(agent.SD_ERR + (proc.stderr.strip() or "RCON failed (server not running?)"), file=sys.stderr)
    sys.exit(1)
json.dump({"output": proc.stdout.rstrip()}, fp=sys.stdout)
