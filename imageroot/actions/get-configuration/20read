# Return the stored settings plus live server state (A2S_INFO query on the
# game port: map, players, version) and a connection hint (node IP:port).

import json
import os
import re
import subprocess
import sys

env = os.environ

extra = []
try:
    with open("cs2-extra.env") as fp:
        extra = [l.rstrip("\n") for l in fp if l.strip() and not l.startswith("#")]
except FileNotFoundError:
    pass

running = False
info = {}
try:
    st = subprocess.run(["podman", "inspect", "cs2", "--format", "{{.State.Status}}"],
                        capture_output=True, text=True, timeout=10).stdout.strip()
    running = st == "running"
    if running:
        out = subprocess.run([os.path.expanduser("~/.config/bin/cs2-query"), env.get("GAME_PORT", "27015")],
                             capture_output=True, text=True, timeout=15).stdout
        info = json.loads(out or "{}")
except Exception:
    pass

node_ip = ""
try:
    out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True, timeout=5).stdout
    m = re.search(r"\bsrc (\S+)", out)
    node_ip = m.group(1) if m else ""
except Exception:
    pass

config = {
    "server_name": env.get("SERVER_NAME", ""),
    "server_password": env.get("SERVER_PASSWORD", ""),
    "gslt_token_set": bool(env.get("GSLT_TOKEN", "")),
    "max_players": int(env.get("MAX_PLAYERS", "10")),
    "game_port": int(env.get("GAME_PORT", "27015")),
    "lan_mode": env.get("LAN_MODE") == "true",
    "game_mode": env.get("GAME_MODE", "competitive"),
    "map_group": env.get("MAP_GROUP", "mg_active"),
    "start_map": env.get("START_MAP", "de_inferno"),
    "workshop_collection": env.get("WORKSHOP_COLLECTION", ""),
    "workshop_map": env.get("WORKSHOP_MAP", ""),
    "bot_difficulty": int(env.get("BOT_DIFFICULTY", "1")),
    "bot_quota": int(env.get("BOT_QUOTA", "0")),
    "bot_quota_mode": env.get("BOT_QUOTA_MODE", "fill"),
    "tv_enabled": env.get("TV_ENABLED") == "true",
    "tv_port": int(env.get("TV_PORT", "27020")),
    "tv_password": env.get("TV_PASSWORD", ""),
    "tv_delay": int(env.get("TV_DELAY", "0")),
    "tv_autorecord": env.get("TV_AUTORECORD") == "true",
    "validate_files": env.get("VALIDATE_FILES") == "true",
    "additional_args": env.get("ADDITIONAL_ARGS", ""),
    "extra_env": extra,
    "server_running": running,
    "server_online": "name" in info,
    "server_version": info.get("version", ""),
    "current_map": info.get("map", ""),
    "players_online": info.get("players"),
    "players_max": info.get("max_players"),
    "bots_online": info.get("bots"),
    "node_ip": node_ip,
}
json.dump(config, fp=sys.stdout)
