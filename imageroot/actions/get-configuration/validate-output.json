{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/cs2/get-configuration-output.json",
    "description": "Get Counter-Strike 2 server configuration",
    "type": "object",
    "properties": {
        "server_name": { "type": "string" },
        "server_password": { "type": "string" },
        "gslt_token_set": { "type": "boolean" },
        "max_players": { "type": "integer" },
        "game_port": { "type": "integer" },
        "lan_mode": { "type": "boolean" },
        "game_mode": { "type": "string" },
        "map_group": { "type": "string" },
        "start_map": { "type": "string" },
        "workshop_collection": { "type": "string" },
        "workshop_map": { "type": "string" },
        "bot_difficulty": { "type": "integer" },
        "bot_quota": { "type": "integer" },
        "bot_quota_mode": { "type": "string" },
        "tv_enabled": { "type": "boolean" },
        "tv_port": { "type": "integer" },
        "tv_password": { "type": "string" },
        "tv_delay": { "type": "integer" },
        "tv_autorecord": { "type": "boolean" },
        "validate_files": { "type": "boolean" },
        "additional_args": { "type": "string" },
        "extra_env": { "type": "array", "items": { "type": "string" } },
        "server_running": { "type": "boolean" },
        "server_online": { "type": "boolean" },
        "server_version": { "type": "string" },
        "current_map": { "type": "string" },
        "players_online": { "type": ["integer", "null"] },
        "players_max": { "type": ["integer", "null"] },
        "bots_online": { "type": ["integer", "null"] },
        "node_ip": { "type": "string" }
    }
}
