# Generate the RCON password into state/passwords.env (mode 0600): secrets must
# not be stored in state/environment, which NS8 mirrors to Redis in plain text.
# The join password, the GSLT token and the CSTV password are written to the
# same file by configure-module.

import secrets

import modsecrets

modsecrets.ensure({"RCON_PASSWORD": secrets.token_hex(16)})
